# Skopiuj do .env i ustaw IP swojej maszyny dla testów na fizycznym telefonie:
# (znajdz IP: ipconfig -> 'Wireless LAN adapter' lub 'Ethernet adapter')
EXPO_PUBLIC_API_URL=http://192.168.0.100:5156

# Dla web (przegladarka) i iOS simulator wystarczy:
# EXPO_PUBLIC_API_URL=http://localhost:5156

# Android emulator uzywa specjalnego IP dla hosta:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5156
